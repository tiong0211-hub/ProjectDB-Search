__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Generated index/data — not source, regenerated by `projectdb-search index`
data/index/*
!data/index/.gitkeep
data/logs/

# Generated test fixtures (created by tests/fixtures/generate_fixtures.py)
tests/fixtures/raw_docs/

# Offline packaging artifacts -- binary, regenerated by download_wheels.sh,
# or manually vendored (Python embeddable zip, Tesseract, Poppler). Keep
# the manifest/scripts, not the binaries themselves.
packaging/embeddable/wheels/
packaging/embeddable/dist/
packaging/embeddable/python-embed/
packaging/vendor/
